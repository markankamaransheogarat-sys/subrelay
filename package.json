{
  "name": "subrelay",
  "version": "1.0.0",
  "private": true,
  "description": "P2P Subscription Sharing & Escrow Platform (Spotify, Steam, Midjourney, Claude, Cursor)",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev:server": "nodemon server/index.js",
